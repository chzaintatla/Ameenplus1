rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deeds images - allow authenticated users to upload and read
    // Path: deeds/{userId}/{imageId}
    match /deeds/{userId}/{imageId} {
      // Allow read for authenticated users
      allow read: if request.auth != null;
      
      // Allow create (upload new files) for authenticated users
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 && // 10MB limit
        request.resource.contentType.matches('image/.*');
      
      // Allow update for authenticated users (in case of retry)
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      
      // Allow delete for authenticated users (for cleanup)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // User profile images
    match /profiles/{userId}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 && // 5MB limit
        request.resource.contentType.matches('image/.*');
    }
    
    // Chat media files
    // Path: chat_media/{chatId}/{mediaId}
    // Note: Full participant verification must be done in application layer
    // Storage rules can only verify authentication and file constraints
    match /chat_media/{chatId}/{mediaId} {
      // Allow read for authenticated users (participant check in app layer)
      allow read: if request.auth != null;
      
      // Allow create for authenticated users with size and type validation
      // Application layer must verify user is a chat participant
      allow create: if request.auth != null &&
        request.resource.size < 50 * 1024 * 1024 && // 50MB limit
        request.resource.contentType.matches('.*');
      
      // Allow update only for retry scenarios (same constraints)
      allow update: if request.auth != null &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('.*');
      
      // Allow delete for authenticated users (cleanup)
      allow delete: if request.auth != null;
    }
    
    // Community media files
    // Path: communities/{communityId}/{mediaId}
    // Note: Full member verification must be done in application layer
    // Storage rules can only verify authentication and file constraints
    match /communities/{communityId}/{mediaId} {
      // Allow read for authenticated users (member check in app layer)
      allow read: if request.auth != null;
      
      // Allow create for authenticated users with size and type validation
      // Application layer must verify user is a community member
      allow create: if request.auth != null &&
        request.resource.size < 50 * 1024 * 1024 && // 50MB limit
        request.resource.contentType.matches('.*');
      
      // Allow update only for retry scenarios (same constraints)
      allow update: if request.auth != null &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('.*');
      
      // Allow delete for authenticated users (cleanup)
      allow delete: if request.auth != null;
    }
    
  }
}
