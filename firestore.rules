rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to get current user ID
    function currentUserId() {
      return request.auth.uid;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read public profiles
      allow read: if true;
      
      // Users can create their own profile
      allow create: if isOwner(userId);
      
      // Users can update their own profile
      allow update: if isOwner(userId);
      
      // Users can delete their own profile
      allow delete: if isOwner(userId);
    }
    
    // Deeds/Posts collection
    match /deeds/{deedId} {
      // Anyone can read validated deeds or their own deeds
      allow read: if resource.data.isValidated == true || 
                     isOwner(resource.data.userId);
      
      // Authenticated users can create deeds (with isValidated: false)
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == currentUserId() &&
                       request.resource.data.isValidated == false;
      
      // Users can update their own deeds (but not validation status)
      allow update: if isOwner(resource.data.userId) &&
                       request.resource.data.isValidated == resource.data.isValidated;
      
      // Only backend/service account can update validation status
      // (This should be done via Cloud Functions or Admin SDK)
      allow update: if request.resource.data.isValidated != resource.data.isValidated &&
                       false; // Disabled - use Cloud Functions instead
      
      // Users can delete their own deeds
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Comments collection
    match /comments/{commentId} {
      // Anyone can read comments
      allow read: if true;
      
      // Authenticated users can create comments
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == currentUserId();
      
      // Users can update their own comments
      allow update: if isOwner(resource.data.userId);
      
      // Users can delete their own comments
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Likes subcollection (nested under deeds)
    match /deeds/{deedId}/likes/{likeId} {
      // Anyone can read likes
      allow read: if true;
      
      // Authenticated users can like/unlike
      allow create, delete: if isAuthenticated() && 
                               request.resource.data.userId == currentUserId();
    }
    
    // Follows collection
    match /follows/{followId} {
      // Users can read their own follows
      allow read: if isAuthenticated();
      
      // Users can create follow relationships
      allow create: if isAuthenticated() && 
                       request.resource.data.followerId == currentUserId();
      
      // Users can delete their own follow relationships
      allow delete: if isAuthenticated() && 
                       resource.data.followerId == currentUserId();
    }
    
    // Friends collection
    match /friends/{friendId} {
      // Users can read their own friend relationships
      allow read: if isAuthenticated() && 
                     (resource.data.userId1 == currentUserId() || 
                      resource.data.userId2 == currentUserId());
      
      // Users can create friend relationships
      allow create: if isAuthenticated() && 
                       (request.resource.data.userId1 == currentUserId() || 
                        request.resource.data.userId2 == currentUserId());
      
      // Users can update their own friend relationships
      allow update: if isAuthenticated() && 
                       (resource.data.userId1 == currentUserId() || 
                        resource.data.userId2 == currentUserId());
      
      // Users can delete their own friend relationships
      allow delete: if isAuthenticated() && 
                       (resource.data.userId1 == currentUserId() || 
                        resource.data.userId2 == currentUserId());
    }
    
    // Friend requests collection
    match /friendRequests/{requestId} {
      // Users can read requests they sent or received
      allow read: if isAuthenticated() && 
                     (resource.data.senderId == currentUserId() || 
                      resource.data.receiverId == currentUserId());
      
      // Users can create friend requests
      allow create: if isAuthenticated() && 
                       request.resource.data.senderId == currentUserId();
      
      // Users can update requests they received (to accept/reject)
      allow update: if isAuthenticated() && 
                       resource.data.receiverId == currentUserId();
      
      // Users can delete requests they sent or received
      allow delete: if isAuthenticated() && 
                       (resource.data.senderId == currentUserId() || 
                        resource.data.receiverId == currentUserId());
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && 
                     resource.data.userId == currentUserId();
      
      // System can create notifications (via Cloud Functions)
      allow create: if false; // Use Cloud Functions instead
      
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && 
                       resource.data.userId == currentUserId();
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated() && 
                       resource.data.userId == currentUserId();
    }
    
    // Communities collection
    match /communities/{communityId} {
      // Anyone can read public communities
      allow read: if resource.data.isPublic == true || 
                     isAuthenticated();
      
      // Authenticated users can create communities
      allow create: if isAuthenticated() && 
                       request.resource.data.createdBy == currentUserId();
      
      // Community creators and admins can update
      allow update: if isAuthenticated() && 
                       (resource.data.createdBy == currentUserId() ||
                        currentUserId() in resource.data.admins);
      
      // Community creators can delete
      allow delete: if isAuthenticated() && 
                       resource.data.createdBy == currentUserId();
    }
    
    // Community members subcollection
    match /communities/{communityId}/members/{memberId} {
      // Community members can read member list
      allow read: if isAuthenticated();
      
      // Users can join communities
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == currentUserId();
      
      // Users can leave communities
      allow delete: if isAuthenticated() && 
                       (resource.data.userId == currentUserId() ||
                        get(/databases/$(database)/documents/communities/$(communityId)).data.createdBy == currentUserId());
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Users can read chats they're part of
      allow read: if isAuthenticated() && 
                     (resource.data.participants != null && 
                      currentUserId() in resource.data.participants);
      
      // Authenticated users can create chats
      allow create: if isAuthenticated() && 
                       currentUserId() in request.resource.data.participants;
      
      // Chat participants can update
      allow update: if isAuthenticated() && 
                       currentUserId() in resource.data.participants;
      
      // Chat participants can delete
      allow delete: if isAuthenticated() && 
                       currentUserId() in resource.data.participants;
    }
    
    // Messages subcollection
    match /chats/{chatId}/messages/{messageId} {
      // Chat participants can read messages
      allow read: if isAuthenticated() && 
                     get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([currentUserId()]);
      
      // Authenticated users can send messages
      allow create: if isAuthenticated() && 
                       request.resource.data.senderId == currentUserId() &&
                       get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([currentUserId()]);
      
      // Users can update their own messages
      allow update: if isAuthenticated() && 
                       resource.data.senderId == currentUserId();
      
      // Users can delete their own messages
      allow delete: if isAuthenticated() && 
                       resource.data.senderId == currentUserId();
    }
    
    // Habits collection
    match /habits/{habitId} {
      // Users can read their own habits
      allow read: if isAuthenticated() && 
                     resource.data.userId == currentUserId();
      
      // Users can create their own habits
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == currentUserId();
      
      // Users can update their own habits
      allow update: if isAuthenticated() && 
                       resource.data.userId == currentUserId();
      
      // Users can delete their own habits
      allow delete: if isAuthenticated() && 
                       resource.data.userId == currentUserId();
    }
    
    // Leaderboard collection (read-only for users)
    match /leaderboard/{userId} {
      // Anyone can read leaderboard
      allow read: if true;
      
      // Only system can write (via Cloud Functions)
      allow write: if false; // Use Cloud Functions instead
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
